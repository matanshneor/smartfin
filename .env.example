SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SECRET_KEY=your-random-secret-key-here
FLASK_ENV=development
FLASK_APP=backend.app
# נדרש רק לפיצ'ר צילום קבלה — מפתח מ-https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# אופציונלי — ראו את הטבלה ב-README
# RATELIMIT_STORAGE_URI=redis://localhost:6379
# RECEIPT_GLOBAL_MONTHLY_LIMIT=2000
# SENTRY_DSN=
# LOG_LEVEL=INFO
# מייל לבעל האתר כשמשפחה נרשמת או שמישהו מצטרף (Resend)
# RESEND_API_KEY=
# OWNER_NOTIFY_EMAIL=
# CSP_REPORT_ONLY=1
# התראות לטלפון (backend/push.py) — בלעדיהן לא נשלחת אף התראה.
# מפתחות: python -c "from backend.push import generate_vapid_keys as g; print(g())"
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# אותו סוד כמו push_cron_secret ב-Supabase Vault
# PUSH_CRON_SECRET=
